          }
        },
        {
          "name": "PATCH Cambiar Estado Activo [ADMIN]",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/2/status",
              "host": ["{{baseUrl}}"],
              "path": ["users", "2", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Categorías",
