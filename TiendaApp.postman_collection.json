{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "TiendaApp - JWT y Roles API",
    "description": "Colección completa de endpoints para TiendaApp con autenticación JWT y control de acceso basado en roles (ADMIN, CLIENTE, VENDEDOR).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
