            }
          }
        }
      ]
    },
    {
      "name": "4. Productos",
      "item": [
        {
          "name": "GET Catálogo Público (Paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET Catálogo Público por Categoría",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?categoryId={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "categoryId", "value": "{{categoryId}}" }
              ]
            }
          }
        },
        {
          "name": "GET Detalle Producto (Público)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "GET Mis Productos [VENDEDOR]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/mine",
              "host": ["{{baseUrl}}"],
              "path": ["products", "mine"]
            }
          }
        },
        {
          "name": "POST Crear Producto [VENDEDOR]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('productId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monitor 27 Pulgadas 144Hz\",\n  \"description\": \"Monitor IPS para gaming y trabajo profesional\",\n  \"price\": 280.50,\n  \"stock\": 10,\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "PUT Editar Producto Propio [VENDEDOR, ADMIN]",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monitor 27 Pulgadas 165Hz Pro\",\n  \"description\": \"Monitor actualizado a 165Hz HDR\",\n  \"price\": 299.99,\n  \"stock\": 8,\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "DELETE Eliminar Producto Propio [VENDEDOR, ADMIN]",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
