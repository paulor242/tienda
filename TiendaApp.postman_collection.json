          "name": "PATCH Cambiar Rol [ADMIN]",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/2/role",
              "host": ["{{baseUrl}}"],
              "path": ["users", "2", "role"]
